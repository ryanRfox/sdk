{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "files": {
    "include": ["**"],
    "ignore": [
      "tsconfig*.json",
      "node_modules/**/*",
      "src/_cjs/**/*",
      "src/_esm/**/*",
      "src/_types/**/*"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "style": {
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingComma": "all",
      "semicolons": "asNeeded"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  }
}
