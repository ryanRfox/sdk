{
	"name": "@radiustechsystems/sdk",
	"version": "2.0.0-alpha.5",
	"description": "TypeScript SDK for interacting with the Radius Platform",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radiustechsystems/sdk.git"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm clean && pnpm build:esm && pnpm build:types",
		"build:esm": "tsc --project ./tsconfig.build.json --module esnext --moduleResolution bundler --outDir ./src/_esm && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./src/_esm/package.json",
		"build:types": "tsc --project ./tsconfig.build.json --module esnext --moduleResolution bundler --declarationDir ./src/_types --emitDeclarationOnly --declaration --declarationMap",
		"check": "biome check . --fix --unsafe",
		"check:types": "tsc --noEmit",
		"clean": "rimraf src/_types src/_esm ./tsconfig.build.tsbuildinfo src/tsconfig.build.tsbuildinfo",
		"format": "biome format --write",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"generate:api": "typedoc",
		"generate:guides": "npx tsx scripts/generate-guides.ts",
		"generate:docs": "pnpm generate:api && pnpm generate:guides",
		"docs:check": "npx tsx scripts/validate-docs.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.2",
		"@tanstack/react-query": "^5.90.16",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.1",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.4",
		"@vitest/coverage-v8": "^4.0.15",
		"jsdom": "27.4.0",
		"react": "^19.1.4",
		"rimraf": "^6.0.1",
		"typedoc": "0.28.16",
		"typedoc-plugin-markdown": "4.9.0",
		"typescript": "^5.9.3",
		"viem": "^2.43.3",
		"vitest": "^4.0.15",
		"wagmi": "^3.1.3"
	},
	"peerDependencies": {
		"@tanstack/react-query": ">=5.0.0",
		"react": ">=18.0.0",
		"typescript": ">=5.0.0",
		"viem": ">=2.0.0",
		"wagmi": ">=3.0.0"
	},
	"peerDependenciesMeta": {
		"wagmi": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"packageManager": "pnpm@9.14.2",
	"main": "./src/_esm/index.js",
	"module": "./src/_esm/index.js",
	"types": "./src/_types/index.d.ts",
	"exports": {
		".": {
			"types": "./src/_types/index.d.ts",
			"import": "./src/_esm/index.js",
			"default": "./src/_esm/index.js"
		},
		"./react": {
			"types": "./src/_types/react/index.d.ts",
			"import": "./src/_esm/react/index.js",
			"default": "./src/_esm/react/index.js"
		},
		"./chains": {
			"types": "./src/_types/chains/index.d.ts",
			"import": "./src/_esm/chains/index.js",
			"default": "./src/_esm/chains/index.js"
		},
		"./events": {
			"types": "./src/_types/events/index.d.ts",
			"import": "./src/_esm/events/index.js",
			"default": "./src/_esm/events/index.js"
		},
		"./webauthn": {
			"types": "./src/_types/webauthn/index.d.ts",
			"import": "./src/_esm/webauthn/index.js",
			"default": "./src/_esm/webauthn/index.js"
		},
		"./wagmi": {
			"types": "./src/_types/wagmi/index.d.ts",
			"import": "./src/_esm/wagmi/index.js",
			"default": "./src/_esm/wagmi/index.js"
		}
	},
	"files": [
		"src/_esm",
		"src/_types"
	],
	"keywords": [
		"radius",
		"evm",
		"viem",
		"wagmi",
		"sdk",
		"ethereum",
		"crypto"
	],
	"homepage": "https://github.com/radiustechsystems/sdk/typescript#readme",
	"bugs": {
		"url": "https://github.com/radiustechsystems/sdk/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@remix-run/fetch-router": "0.14.0"
	}
}
